# Database Connection
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# JWT Secrets (use strong, random values in .env)
JWT_SECRET=your_secret_key_here

# API Configuration
NODE_ENV=development
PORT=3000
INITIAL_ADMIN_EMAIL=admin@Groupe-Gaff.com
INITIAL_ADMIN_NAME="Groupe-Gaff Administrator"
INITIAL_ADMIN_PASSWORD=<MY_SECRET_PASSWORD>
INITIAL_ADMIN_PHONE=<ADMIN_PHONE_REQUIRED>

# Vite DEV-ONLY local admin bootstrap (used only when running `npm run dev`
# without the serverless API). The server never creates this account; the local
# IndexedDB is seeded with a verifier derived from VITE_DEV_ADMIN_PASSWORD.
# Production builds ignore these variables (VITE_DEV_* are compiled away).
# Leave the placeholder angles (<...>) in place to disable the bootstrap.
VITE_DEV_ADMIN_EMAIL=<DEV_ADMIN_EMAIL>
VITE_DEV_ADMIN_PASSWORD=<DEV_ADMIN_PASSWORD>
